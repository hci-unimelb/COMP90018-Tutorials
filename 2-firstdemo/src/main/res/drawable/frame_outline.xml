<?xml version="1.0" encoding="utf-8"?>
<!--
    A dashed "parent boundary" frame used in the Padding vs Margin demo, so students can
    literally see where the parent container ends and where a child view's own edge is.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#F2F2F2" />
    <stroke
        android:width="1dp"
        android:color="#999999"
        android:dashWidth="4dp"
        android:dashGap="3dp" />
    <corners android:radius="4dp" />
</shape>
