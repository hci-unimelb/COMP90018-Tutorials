<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gallery_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Layout Gallery"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:text="Tap a tab to compare layouts. Sizes below are dp, not px."
        android:textSize="13sp"
        android:textColor="#666666" />

    <!-- Segmented control: MaterialButtonToggleGroup is the native Material Components
         equivalent of iOS's segmented control, already available via the material dependency.
         Wrapped in a HorizontalScrollView since six segments don't all fit on a phone width. -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/layout_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_padding_margin"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pad / Margin" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_linear"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Linear" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_relative"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Relative" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_constraint"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Constraint" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_grid"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Grid" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_table"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Table" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

    </HorizontalScrollView>

    <!-- All six demos are inflated up front; only one is made VISIBLE at a time -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:background="#11000000">

        <include
            android:id="@+id/demo_padding_margin"
            layout="@layout/layout_gallery_padding_margin" />

        <include
            android:id="@+id/demo_linear"
            layout="@layout/layout_gallery_linear"
            android:visibility="gone" />

        <include
            android:id="@+id/demo_relative"
            layout="@layout/layout_gallery_relative"
            android:visibility="gone" />

        <include
            android:id="@+id/demo_constraint"
            layout="@layout/layout_gallery_constraint"
            android:visibility="gone" />

        <include
            android:id="@+id/demo_grid"
            layout="@layout/layout_gallery_grid"
            android:visibility="gone" />

        <include
            android:id="@+id/demo_table"
            layout="@layout/layout_gallery_table"
            android:visibility="gone" />

    </FrameLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="#22000000">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/explanation_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/explanation_use"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/explanation_tip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="13sp"
                android:textStyle="italic"
                android:textColor="#3D7A56" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
