<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Text demo: raw bytes happen to be readable text here -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text="Text file" />

            <EditText
                android:id="@+id/edit_text"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:hint="@string/hint" />

            <Button
                android:id="@+id/save_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/save" />

            <Button
                android:id="@+id/load_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/load" />

            <Button
                android:id="@+id/clear_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/clear" />

            <TextView
                style="@style/ActionCaption"
                android:layout_marginTop="8dp"
                android:text="Writes the text above as raw bytes to a private file, one character encoding away from being an image." />

            <!--
                Image demo: same openFileOutput/openFileInput APIs, but the bytes are a PNG,
                not text. Proves Internal Storage stores bytes, not "strings" — text was
                only ever one way of interpreting them.
            -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:textStyle="bold"
                android:text="Image file (raw bytes, not text)" />

            <ImageView
                android:id="@+id/image_preview"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="8dp"
                android:background="#EEEEEE"
                android:scaleType="centerInside"
                android:contentDescription="@null" />

            <Button
                android:id="@+id/save_image_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/save_image" />

            <TextView
                style="@style/ActionCaption"
                android:text="Draws a timestamped bitmap in memory and writes its PNG bytes to a private file. Tap twice — the timestamp changes both times." />

            <Button
                android:id="@+id/load_image_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/load_image" />

            <TextView
                style="@style/ActionCaption"
                android:text="Reads those bytes back off disk and decodes them into the picture above." />

            <Button
                android:id="@+id/clear_image_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/clear_image" />

            <TextView
                style="@style/ActionCaption"
                android:text="Only clears the preview above — the file on disk is untouched until Save Image runs again." />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
